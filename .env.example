# SweeTrade (sweetrade.pk) — example environment configuration
# Copy this file to .env for local development. Use real values ONLY in your
# local .env or your hosting provider's environment/secret settings.
# Do not commit your actual .env.

# Public settings bundled into the browser by Vite.
# Use the Supabase project's publishable/anon key, NEVER a service-role key.
VITE_SUPABASE_PROJECT_ID=your-supabase-project-id
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-side equivalents for SSR and API/server functions.
SUPABASE_PROJECT_ID=your-supabase-project-id
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only privileged key, if a trusted server route requires it.
# Never prefix with VITE_ and never expose this key in frontend code.
# Set it securely in your deployment environment when needed.
SUPABASE_SERVICE_ROLE_KEY=
